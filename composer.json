{
    "name": "brigantia/aplicacion",
    "description": "Aplicación sobre brigantia/nucleo",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "path",
            "url": "../nucleo"
        }
    ],
    "require": {
        "php": ">=8.1",
        "brigantia/nucleo": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    }
}
